# =======================================
# ~/.zshrc
# =======================================

# ---------------------------------------
# Profiling
# Uncomment while tuning startup
# ---------------------------------------
# zmodload zsh/zprof

# ---------------------------------------
# Silence login message
# ---------------------------------------
[[ ! -f "$HOME/.hushlogin" ]] && touch "$HOME/.hushlogin"

# ---------------------------------------
# Performance / safety tweaks
# ---------------------------------------
export ZSH_DISABLE_COMPFIX=true

# ---------------------------------------
# Base directories
# ---------------------------------------
ZSH_DIR="$HOME/.zsh"
ANTIDOTE_DIR="$ZSH_DIR/antidote"
CACHE_DIR="$ZSH_DIR/cache"
CACHE_FILE="$CACHE_DIR/plugins.zsh"
PLUGIN_HASH_FILE="$CACHE_DIR/.plugin_hash"

mkdir -p "$CACHE_DIR"

# ---------------------------------------
# Homebrew detection
# ---------------------------------------
if [[ -x "/opt/homebrew/bin/brew" ]]; then
  BREW_PREFIX="/opt/homebrew"
elif [[ -x "/usr/local/bin/brew" ]]; then
  BREW_PREFIX="/usr/local"
fi

# ---------------------------------------
# Environment / exports
# ---------------------------------------
export PATH="$HOME/bin:$PATH"
[[ -n "$BREW_PREFIX" ]] && export PATH="$BREW_PREFIX/opt/ruby/bin:$BREW_PREFIX/bin:$BREW_PREFIX/sbin:$PATH"

# User local binaries
[[ -d "$HOME/.lmstudio/bin" ]] && export PATH="$HOME/.lmstudio/bin:$PATH"
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

export EDITOR='vim'
export LC_ALL='en_US.UTF-8'
export HOMEBREW_NO_ANALYTICS=1
export PYTHONIOENCODING='UTF-8'

export LESS_TERMCAP_mb=$'\e[1;31m'
export LESS_TERMCAP_md=$'\e[1;33m'
export LESS_TERMCAP_so=$'\e[01;44;37m'
export LESS_TERMCAP_us=$'\e[01;37m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_ue=$'\e[0m'
export MANPAGER='less -s -M +Gg'

# ---------------------------------------
# History settings
# ---------------------------------------
export HISTSIZE=100000
export SAVEHIST=100000
export HISTFILE="${HOME}/.zsh_history"
export HISTORY_IGNORE="(history|ls|cd)"
export HISTTIMEFORMAT=""
export HIST_STAMPS="dd.mm.yyyy"

# ---------------------------------------
# Oh My Zsh / use-omz settings
# Must be set before plugin load
# ---------------------------------------
export DISABLE_AUTO_UPDATE="true"
export DISABLE_UPDATE_PROMPT="true"
export UPDATE_ZSH_DAYS=99999
export DISABLE_MAGIC_FUNCTIONS="true"
export CASE_SENSITIVE="true"
export DISABLE_AUTO_TITLE="true"

# ---------------------------------------
# Shell options
# ---------------------------------------
setopt AUTO_CD
setopt EXTENDED_HISTORY
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_SAVE_NO_DUPS
setopt INC_APPEND_HISTORY
setopt INTERACTIVE_COMMENTS
setopt SHARE_HISTORY
setopt NO_BEEP
unsetopt PROMPT_SP
unsetopt MENU_COMPLETE
setopt AUTO_MENU

# ---------------------------------------
# Completion path
# compinit is handled by use-omz
# ---------------------------------------
[[ -n "$BREW_PREFIX" ]] && FPATH="$BREW_PREFIX/share/zsh/site-functions:$FPATH"

# ---------------------------------------
# LS_COLORS
# Must be loaded before completion styles
# ---------------------------------------
if [[ -f "$ZSH_DIR/ls_colors.zsh" ]]; then
  source "$ZSH_DIR/ls_colors.zsh"
elif command -v gdircolors >/dev/null 2>&1; then
  eval "$(gdircolors -b "$HOME/.config/dircolors" 2>/dev/null || gdircolors -b)"
fi

# ---------------------------------------
# Completion UI settings
# ---------------------------------------
zstyle ':completion:*' verbose yes
zstyle ':completion:*:options' description yes
zstyle ':completion:*:descriptions' format $'\n\e[1;37m%d\e[0m'
zstyle ':completion:*:messages' format $'%{\e[38;05;239m%} Message : %d%{\e[m%}'
zstyle ':completion:*:warnings' format $'%{\e[38;05;238m%} No matches in %d%{\e[m%}'
zstyle ':completion:*' select-prompt $'%{\e[38;05;249m%}%SSelection at %p%s%{\e[m%}'
zstyle ':completion:*' completer _complete _ignored _approximate
zstyle ':completion:*' list-packed true
zstyle ':completion:*' list-dirs-first true
zstyle ':completion:*' list-separator ''
zstyle ':completion:*' group-order options arguments values directories files
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
[[ -n "$LS_COLORS" ]] && zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':bracketed-paste-magic' active-widgets '.self-*'

# ---------------------------------------
# fzf-tab settings
# ---------------------------------------
zstyle ':fzf-tab:*' show-group none
zstyle ':fzf-tab:*' prefix ''
zstyle ':fzf-tab:*' switch-group ',' '.'
zstyle ':fzf-tab:*' fzf-command fzf
zstyle ':fzf-tab:*' fzf-flags --height=75% --layout=reverse --border --inline-info
zstyle ':fzf-tab:*' use-fzf-default-opts yes

# if command -v eza >/dev/null 2>&1; then
#   zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza --all --group-directories-first --color=always $realpath'	
# elif command -v gls >/dev/null 2>&1; then
#   zstyle ':fzf-tab:complete:cd:*' fzf-preview 'gls -a --color=always $realpath'
# else
#   zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -ah $realpath'
# fi

zstyle ':fzf-tab:*' fzf-flags --height=75% --layout=reverse --border --inline-info --preview-window=right:40% --bind=alt-p:toggle-preview

zstyle ':fzf-tab:complete:(cd|ls|eza|gls):*' fzf-preview '
if [[ -d "$realpath" ]]; then
  command gls -a --color=always -- "$realpath"

elif [[ -f "$realpath" ]]; then
  size=$(stat -f%z "$realpath" 2>/dev/null)

  if [[ -n "$size" && "$size" -gt 512000 ]]; then
    printf "File too large to preview\n\n"
    printf "Name: %s\n" "$(basename -- "$realpath")"
    printf "Size: %s KB\n" "$(( size / 1024 ))"
    exit 0
  fi

  if command -v bat >/dev/null 2>&1; then
    bat --style=numbers --color=always --line-range :300 -- "$realpath"
  else
    sed -n "1,200p" -- "$realpath"
  fi

else
  command gls -a --color=always -- "$(dirname -- "$realpath")"
fi
'

# ---------------------------------------
# Native fzf setup
# ---------------------------------------
unset FZF_DEFAULT_OPTS
unset FZF_CTRL_T_OPTS
unset FZF_ALT_C_OPTS
unset FZF_CTRL_R_OPTS
unset FZF_DEFAULT_COMMAND
unset FZF_CTRL_T_COMMAND
unset FZF_ALT_C_COMMAND

if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
else
  export FZF_DEFAULT_COMMAND='find . -type f 2>/dev/null'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='find . -type d 2>/dev/null'
fi

export FZF_DEFAULT_OPTS='--height=75% --layout=reverse --border --inline-info --cycle --color=fg:#d0d0d0,bg:#1c1c1c,hl:#00afff,fg+:#ffffff,bg+:#303030,hl+:#ff8700'
# export FZF_DEFAULT_OPTS='--height=75% --layout=reverse --border --inline-info --cycle'

if command -v bat >/dev/null 2>&1; then
  export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :300 {} 2>/dev/null || sed -n \"1,200p\" {} 2>/dev/null' --preview-window=right,50%,border-left"
else
  export FZF_CTRL_T_OPTS="--preview 'sed -n \"1,200p\" {} 2>/dev/null' --preview-window=right,50%,border-left"
fi

if command -v eza >/dev/null 2>&1; then
  export FZF_ALT_C_OPTS="--preview 'eza --all --long --group-directories-first --color=always {} 2>/dev/null' --preview-window=right,50%,border-left"
elif command -v gls >/dev/null 2>&1; then
  export FZF_ALT_C_OPTS="--preview 'gls -ah --color=always {} 2>/dev/null' --preview-window=right,50%,border-left"
else
  export FZF_ALT_C_OPTS="--preview 'ls -ah {} 2>/dev/null' --preview-window=right,50%,border-left"
fi

export FZF_CTRL_R_OPTS='--layout=reverse --height=75% --border --preview-window=hidden'



# ---------------------------------------
# Install Antidote (if missing)
# ---------------------------------------
if [[ ! -d "$ANTIDOTE_DIR" ]]; then
  echo "⚡ Installing antidote..."
  git clone --depth=1 https://github.com/mattmc3/antidote "$ANTIDOTE_DIR"
fi

source "$ANTIDOTE_DIR/antidote.zsh"

# ---------------------------------------
# Build plugin cache only when needed
# ---------------------------------------
NEW_HASH=$(cat <<'EOF' | shasum
getantidote/use-omz
ohmyzsh/ohmyzsh path:lib
zsh-users/zsh-completions
ohmyzsh/ohmyzsh path:plugins/copybuffer
ohmyzsh/ohmyzsh path:plugins/copyfile
ohmyzsh/ohmyzsh path:plugins/copypath
ohmyzsh/ohmyzsh path:plugins/per-directory-history
ohmyzsh/ohmyzsh path:plugins/dircycle
Aloxaf/fzf-tab
zsh-users/zsh-autosuggestions
zdharma-continuum/fast-syntax-highlighting
fdellwing/zsh-bat
sunlei/zsh-ssh
EOF
)

OLD_HASH=$(cat "$PLUGIN_HASH_FILE" 2>/dev/null)

if [[ "$NEW_HASH" != "$OLD_HASH" ]]; then
  echo "⚡ Rebuilding plugin cache..."
  echo "$NEW_HASH" > "$PLUGIN_HASH_FILE"

  antidote bundle <<'EOF' > "$CACHE_FILE"
getantidote/use-omz
ohmyzsh/ohmyzsh path:lib
zsh-users/zsh-completions
ohmyzsh/ohmyzsh path:plugins/copybuffer
ohmyzsh/ohmyzsh path:plugins/copyfile
ohmyzsh/ohmyzsh path:plugins/copypath
ohmyzsh/ohmyzsh path:plugins/per-directory-history
ohmyzsh/ohmyzsh path:plugins/dircycle
Aloxaf/fzf-tab
zsh-users/zsh-autosuggestions
zdharma-continuum/fast-syntax-highlighting
fdellwing/zsh-bat
sunlei/zsh-ssh
EOF
fi

# ---------------------------------------
# Load plugins
# ---------------------------------------
source "$CACHE_FILE"

# ---------------------------------------
# Load native fzf shell integration
# Do this after plugins
# ---------------------------------------
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/opt/fzf/shell/completion.zsh" ]]; then
  source "$BREW_PREFIX/opt/fzf/shell/completion.zsh"
fi

if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh" ]]; then
  source "$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
fi

# ---------------------------------------
# Hooks
# ---------------------------------------
autoload -Uz add-zsh-hook
zmodload zsh/datetime

# ---------------------------------------
# direnv (lazy safe load)
# ---------------------------------------
if command -v direnv >/dev/null 2>&1; then
  _direnv_hook() {
    eval "$(direnv hook zsh)"
    unfunction _direnv_hook
  }
  add-zsh-hook precmd _direnv_hook
fi

# ---------------------------------------
# Functions
# ---------------------------------------
fancy_ctrl_z() {
  if [[ $#BUFFER -eq 0 ]]; then
    local BUFFER="fg"
    zle accept-line -w
  else
    zle push-input -w
    zle clear-screen -w
  fi
}

get_bundleid() {
  osascript -e 'on run args
	set output to {}
	repeat with a in args
		set end of output to id of app a
	end
	set text item delimiters to linefeed
	output as text
	end' "$1"
}

encrypt_256() {
  openssl enc -aes-256-cbc -in "$1" -out "$2"
}

decrypt_256() {
  openssl enc -aes-256-cbc -d -in "$1" -out "$2"
}

convert() {
  case "$1" in
    texttobase) print -n "$2" | base64 ;;
    basetotext) print -n "$2" | base64 -d && echo ;;
    texttohex) print -n "0x$(printf '%s' "$2" | xxd -p)" && echo ;;
    hextotext) print -n "${2#0x}" | xxd -r -p && echo ;;
    texttobin) print -n "$2" | perl -lape '$_=unpack"B*"' ;;
    bintotext) print -n "$2" | perl -lape '$_=pack"B*",$_' ;;
    hextobase) print -n "0x$(printf '%s' "${2#0x}" | xxd -r -p | base64)" && echo ;;
    basetohex) print -n "0x$(printf '%s' "$2" | base64 -d | xxd -p)" && echo ;;
    *)
      print "Invalid conversion type. Available options: basetohex, hextobase, texttobase, basetotext, texttobin, bintotext, hextotext, texttohex"
      ;;
  esac
}

kext_perm_fix() {
  sudo chown -R 0:0 "$1"
  sudo chmod -R 0755 "$1"
}

# ---------------------------------------
# Key bindings
# ---------------------------------------
zle -N fancy_ctrl_z
bindkey '^Z' fancy_ctrl_z

# Dircycle widget bindings
bindkey '^[b' insert-cycledleft
bindkey '^[f' insert-cycledright
# bindkey '^B' insert-cycledleft
# bindkey '^N' insert-cycledright

# Leave disabled when using fzf-tab
# bindkey '^I' menu-complete
# bindkey "$terminfo[kcbt]" reverse-menu-complete

# ---------------------------------------
# Prompt
# ---------------------------------------

# Palette (truecolor)
typeset -g _PC_PATH=$'\e[38;2;178;178;165m'   # #B2B2A5 stone
typeset -g _PC_GIT=$'\e[38;2;242;153;38m'     # #F29926 orange
typeset -g _PC_DIRTY=$'\e[38;2;191;127;38m'   # #BF7F26 amber
typeset -g _PC_TIME=$'\e[38;2;127;127;114m'   # #7F7F72 slate
typeset -g _PC_OK=$'\e[38;2;242;153;178m'     # #F299B2 pink
typeset -g _PC_ERR=$'\e[38;2;191;76;51m'      # #BF4C33 brick
typeset -g _PC_RUN=$'\e[38;2;242;153;38m'     # #F29926 orange
typeset -g _PC_RST=$'\e[0m'

typeset -g _prompt_cmd_start=""
typeset -g _prompt_elapsed=""

_prompt_draw() {
  local path_plain="${(%):-%~}"
  local branch dirty_plain="" dirty_colored="" time_str
  local time_plain time_colored right_plain right_colored pad

  branch=$(git symbolic-ref --short HEAD 2>/dev/null)
  time_str=$(date +%H:%M)

  if [[ -n "$branch" ]]; then
    if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
      dirty_plain=" *"
      dirty_colored="%{${_PC_DIRTY}%} *%{${_PC_RST}%}"
    fi
  fi

  if [[ -n "$_prompt_elapsed" ]]; then
    time_plain="${time_str} (~${_prompt_elapsed}s)"
    time_colored="%{${_PC_TIME}%}${time_str} (~${_prompt_elapsed}s)%{${_PC_RST}%}"
  else
    time_plain="${time_str}"
    time_colored="%{${_PC_TIME}%}${time_str}%{${_PC_RST}%}"
  fi

  if [[ -n "$branch" ]]; then
    right_plain="git:${branch}${dirty_plain}   ${time_plain}"
    right_colored="%{${_PC_GIT}%}git:${branch}%{${_PC_RST}%}${dirty_colored}   ${time_colored}"
  else
    right_plain="${time_plain}"
    right_colored="${time_colored}"
  fi

  pad=$(( COLUMNS - ${#path_plain} - ${#right_plain} ))
  (( pad < 2 )) && pad=2

  print -P "%{${_PC_PATH}%}%~%{${_PC_RST}%}${(l:${pad}:: :)}${right_colored}"
}

_prompt_precmd() {
  local exit_code=$?

  _prompt_elapsed=""
  if [[ -n "$_prompt_cmd_start" ]]; then
    local elapsed=$(( EPOCHREALTIME - _prompt_cmd_start ))
    if (( elapsed >= 2 )); then
      _prompt_elapsed="$(printf '%.1f' $elapsed)"
    fi
    _prompt_cmd_start=""
  fi

  RPROMPT=""
  _prompt_draw

  if (( exit_code != 0 )); then
    PROMPT="%{${_PC_ERR}%}${exit_code} ❯%{${_PC_RST}%} "
  else
    PROMPT="%{${_PC_OK}%}❯%{${_PC_RST}%} "
  fi
}

_prompt_preexec() {
  _prompt_cmd_start=$EPOCHREALTIME
  PROMPT="%{${_PC_RUN}%}❯%{${_PC_RST}%} "
  zle reset-prompt 2>/dev/null || true
}

add-zsh-hook precmd _prompt_precmd
add-zsh-hook preexec _prompt_preexec

# ---------------------------------------
# Aliases
# ---------------------------------------
if command -v gls >/dev/null 2>&1; then
  alias ls='gls -G --color'
fi

alias python='python3'
alias pip='pip3'
alias bi='brew install'
alias br='brew remove'
alias bs='brew search'
alias bif='brew info'
# alias bup='brew upgrade ; brew upgrade --cask ; brew cu -ay && brew autoremove && brew cleanup && brew doctor'
alias bup='brew upgrade && brew cu -ay && brew autoremove && brew cleanup && brew doctor'
alias bclp='brew cleanup --prune=all'
alias bd="brew bundle dump --file=$HOME/Brewfile --force --describe"
alias gcl='git clone'
alias pathlist='echo $PATH | tr ":" "\n"'
alias speedtty='noglob sudo rm -rf /private/var/log/asl/*'
alias flushdnscache='sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder'
alias zshreload='exec zsh'
alias codesig='codesign -f -s - --deep'
alias unblock='sudo xattr -r -d com.apple.quarantine'
alias lockfile='chflags uchg'
alias unlockfile='chflags nouchg'
alias compfix='compaudit | xargs chmod g-w'
alias xdropen='open ${HOME}/Library/Developer/Xcode/DerivedData'
alias getkerneldump='log show --debug --last boot --debug --predicate "process == \"kernel\""'
alias termbin='nc termbin.com 9999'
alias editdotfiles='mate ${HOME}/Documents/Repo/dot-files'
alias nmap='sudo grc nmap'
alias atdreload='rm -f ~/.zsh/cache/plugins.zsh ~/.zsh/cache/.plugin_hash && exec zsh'
alias cc='claude'

# ---------------------------------------
# Profiling output
# Uncomment while tuning startup
# ---------------------------------------
# zprof
