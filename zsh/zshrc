_prompt_build_full() {
  local exit_code=$1
  local p=""
  local IC_BRANCH=$''
  local IC_NODE=$''
  local IC_PY=$''
  local IC_RUBY=$''
  local IC_PKG=$''          # nf-fa-cube U+F1B2

  # Folder
  local folder="${PWD:t}"
  [[ "$PWD" == "$HOME" ]] && folder="~"
  [[ "$PWD" == "/" ]] && folder="/"
  if _prompt_sudo_active; then
    p+="%{${_PC_SUDO}%}sudo%{${C_DIM}%} at%{${C_RST}%} "
  fi
  p+="%{${C_FOLDER}%}${folder}%{${C_RST}%}"

  # SSH context
  if [[ -n "$SSH_CLIENT$SSH_TTY" ]]; then
    local ssh_port="${SSH_CLIENT##* }"
    p+=" %{${C_DIM}%}in%{${C_RST}%} %{${C_SSH_USER}%}${USER}%{${C_SSH}%}@${HOST%%.*}:${ssh_port}%{${C_RST}%}"
  fi

  # Branch — fixed orange; git state shown via [!+?] flags
  if [[ -n "$_prompt_branch" ]]; then
    p+=" %{${C_DIM}%}on%{${C_RST}%} %{${C_PKG}%}${IC_BRANCH} ${_prompt_branch}%{${C_RST}%}"
    local git_inner="" git_flags=""
    (( _prompt_unstaged ))  && git_flags+="!"
    (( _prompt_staged ))    && git_flags+="+"
    (( _prompt_untracked )) && git_flags+="?"
    [[ -n "$git_flags" ]] && git_inner+="%{${_PC_GIT_ACTION}%}${git_flags}%{${C_RST}%}"
    (( _prompt_ahead ))  && git_inner+="${git_inner:+ }%{${_PC_GIT_AHEAD}%}↑${_prompt_ahead}%{${C_RST}%}"
    (( _prompt_behind )) && git_inner+="${git_inner:+ }%{${_PC_GIT_BEHIND}%}↓${_prompt_behind}%{${C_RST}%}"
    (( _prompt_stash ))  && git_inner+="${git_inner:+ }%{${_PC_GIT_STASH}%}≡${_prompt_stash}%{${C_RST}%}"
    [[ -n "$git_inner" ]] && p+=" %{${C_DIM}%}[%{${C_RST}%}${git_inner}%{${C_DIM}%}]%{${C_RST}%}"
  fi

  # Package version — awk + mtime cache (no cold node start)
  if [[ -f package.json ]]; then
    local _pm=0; zstat -A _pm +mtime package.json 2>/dev/null
    local pkg_key="${PWD}:${_pm}"
    [[ "$pkg_key" != "$_pvc_pkg_key" ]] && { _pvc_pkg=$(awk -F'"' '/"version"/{print $4;exit}' package.json 2>/dev/null); _pvc_pkg_key="$pkg_key" }
    local pkg_ver="$_pvc_pkg"
    if [[ -n "$pkg_ver" ]]; then
      p+=" %{${C_DIM}%}is%{${C_RST}%} %{${C_PKG}%}${IC_PKG} v${pkg_ver}%{${C_RST}%}"
    fi
  fi

  # Language runtimes — cached, joined with |
  local via_parts=()

  if [[ -f package.json || -f .nvmrc || -f .node-version ]] && command -v node &>/dev/null; then
    local node_key="${NVM_BIN:-}:${NODENV_ROOT:-}:${PATH%%:*}"
    [[ "$node_key" != "$_pvc_node_key" ]] && { _pvc_node=$(node -v 2>/dev/null); _pvc_node_key="$node_key" }
    local nv="$_pvc_node"
    [[ -n "$nv" ]] && via_parts+=("%{${C_NODE}%}${IC_NODE} ${nv#v}%{${C_RST}%}")
  fi

  if [[ -f requirements.txt || -f pyproject.toml || -f setup.py || -f Pipfile || -n "$CONDA_DEFAULT_ENV" || -n "$VIRTUAL_ENV" ]] && command -v python3 &>/dev/null; then
    local py_key="${CONDA_DEFAULT_ENV:-}:${VIRTUAL_ENV:-}:${PYENV_VERSION:-}:${PATH%%:*}"
    [[ "$py_key" != "$_pvc_py_key" ]] && { _pvc_py=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null); _pvc_py_key="$py_key" }
    local pv="$_pvc_py"
    if [[ -n "$pv" ]]; then
      local py_str="${pv}"
      if [[ -n "$CONDA_DEFAULT_ENV" ]]; then
        py_str+=":${CONDA_DEFAULT_ENV}"
      elif [[ -n "$VIRTUAL_ENV" ]]; then
        py_str+=":${VIRTUAL_ENV:t}"
      fi
      via_parts+=("%{${C_PY}%}${IC_PY} ${py_str}%{${C_RST}%}")
    fi
  fi

  if [[ -f Gemfile || -f .ruby-version ]] && command -v ruby &>/dev/null; then
    local ruby_key="${RBENV_VERSION:-}:${GEM_HOME:-}:${PATH%%:*}"
    [[ "$ruby_key" != "$_pvc_ruby_key" ]] && { _pvc_ruby=$(ruby -e 'print RUBY_VERSION' 2>/dev/null); _pvc_ruby_key="$ruby_key" }
    local rv="$_pvc_ruby"
    [[ -n "$rv" ]] && via_parts+=("%{${C_RUBY}%}${IC_RUBY} ${rv}%{${C_RST}%}")
  fi

  if (( ${#via_parts[@]} > 0 )); then
    p+=" %{${C_DIM}%}via [%{${C_RST}%}"
    local i
    for (( i=1; i<=${#via_parts[@]}; i++ )); do
      (( i > 1 )) && p+=" %{${C_DIM}%}|%{${C_RST}%}"
      p+=" ${via_parts[i]}"
    done
    p+=" %{${C_DIM}%}]%{${C_RST}%}"
  fi

  # AWS context
  if [[ -n "$AWS_PROFILE" || -n "$AWS_DEFAULT_REGION" ]]; then
    local aws_ctx="${AWS_PROFILE:-?}:<${AWS_DEFAULT_REGION:-?}>"
    p+=" %{${C_DIM}%}on%{${C_RST}%} %{${C_AWS}%}${aws_ctx}%{${C_RST}%}"
  fi

  # Line 2: background jobs + arrow (cursor line)
  local line2=""
  local job_count=${#jobstates}
  (( job_count > 0 )) && line2+="%{${_PC_BUSY}%}${job_count}&%{${C_RST}%} "
  if (( exit_code != 0 )); then

    line2+="%{${_PC_ERR}%}→%{${C_RST}%} "
  else
    line2+="%{${C_AWS}%}→%{${C_RST}%} "
  fi

  PROMPT="${p}
${line2}"

  # RPROMPT: time + optional elapsed on cursor line right
  local r="%{${C_DIM}%}%D{%H:%M}%{${C_RST}%}"
  [[ -n "$_prompt_elapsed" ]] && r+="%{${C_DIM}%}(~${_prompt_elapsed}s)%{${C_RST}%}"
  RPROMPT="$r"
}

# ── Hooks ─────────────────────────────────────────────────────────────────

_prompt_precmd() {
  _prompt_last_exit=$?

  local cmd_ran=0
  [[ -n "$_prompt_cmd_start" ]] && cmd_ran=1

  if (( _prompt_first_run )); then
    _prompt_first_run=0
  elif (( cmd_ran )); then
    print
  fi

  _prompt_elapsed=""
  if (( cmd_ran )); then
    local elapsed=$(( EPOCHREALTIME - _prompt_cmd_start ))
    if (( elapsed >= 2 )); then
      _prompt_elapsed="$(printf '%.2f' $elapsed)"
    fi
    _prompt_cmd_start=""
  fi

  _prompt_build_rprompt
  if [[ "$_PROMPT_THEME" == "full" ]]; then
    _prompt_build_full $_prompt_last_exit
  else
    _prompt_build_prompt $_prompt_last_exit
  fi
}

_prompt_preexec() {
  _prompt_cmd_start=$EPOCHREALTIME
}

TRAPCHLD() {
  if [[ -z "$_prompt_cmd_start" ]]; then
    _prompt_build_rprompt
    if [[ "$_PROMPT_THEME" == "full" ]]; then
      _prompt_build_full $_prompt_last_exit
    else
      _prompt_build_prompt $_prompt_last_exit
    fi
    zle reset-prompt 2>/dev/null || true
  fi
}

add-zsh-hook precmd _prompt_precmd
add-zsh-hook preexec _prompt_preexec

# ── Transient prompt: collapse to a minimal form once a line is accepted ────
# Each theme collapses to its own shape — compact stays one line, full keeps
# its two-line silhouette (just stripped of flags/pills/clock) so the zle
# redraw never has to change the prompt's line count.

_prompt_build_transient_compact() {
  local exit_code=$1
  local folder="${PWD:t}"
  [[ "$PWD" == "$HOME" ]] && folder="~"
  [[ "$PWD" == "/" ]] && folder="/"

  local p="%{${_PC_FOLDER}%}${folder}%{${_PC_RST}%} "

  if [[ -n "$_prompt_branch" ]]; then
    p+="%{${_PC_DIM}%}on%{${_PC_RST}%} %{${_prompt_branch_color}%}${_prompt_branch}%{${_PC_RST}%} "
  fi

  if (( exit_code != 0 )); then
    p+="%{${_PC_ERR}%}${_PG_ARROW}%{${_PC_RST}%} "
  else
    p+="%{${_PC_OK}%}${_PG_ARROW}%{${_PC_RST}%} "
  fi

  PROMPT="$p"
  RPROMPT=""
}

_prompt_build_transient_full() {
  local exit_code=$1
  local IC_BRANCH=$''

  local folder="${PWD:t}"
  [[ "$PWD" == "$HOME" ]] && folder="~"
  [[ "$PWD" == "/" ]] && folder="/"

  local p="%{${C_FOLDER}%}${folder}%{${C_RST}%}"
  if [[ -n "$_prompt_branch" ]]; then
    p+=" %{${C_DIM}%}on%{${C_RST}%} %{${C_PKG}%}${IC_BRANCH} ${_prompt_branch}%{${C_RST}%}"
  fi

  local line2
  if (( exit_code != 0 )); then
    line2="%{${_PC_ERR}%}→%{${C_RST}%} "
  else
    line2="%{${C_AWS}%}→%{${C_RST}%} "
  fi

  PROMPT="${p}
${line2}"
  RPROMPT=""
}

_prompt_zle_line_finish() {
  if [[ "$_PROMPT_THEME" == "full" ]]; then
    _prompt_build_transient_full $_prompt_last_exit
  else
    _prompt_build_transient_compact $_prompt_last_exit
  fi
  zle .reset-prompt
}

autoload -Uz add-zle-hook-widget
add-zle-hook-widget line-finish _prompt_zle_line_finish

# ---------------------------------------
# Zoxide
# Init output is static per zoxide version -> cache it (mirrors carapace).
# ---------------------------------------
if command -v zoxide >/dev/null 2>&1; then
  () {
    local _zx_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zoxide-init.zsh"
    local _zx_bin; _zx_bin="$(command -v zoxide)"
    local _m_bin=0 _m_cache=0
    zstat -A _m_bin   +mtime "$_zx_bin"    2>/dev/null
    zstat -A _m_cache +mtime "$_zx_cache"  2>/dev/null
    if (( _m_bin > _m_cache )) || [[ ! -s "$_zx_cache" ]]; then
      zoxide init zsh >| "$_zx_cache" 2>/dev/null
    fi
    source "$_zx_cache"
  }
fi

