# ---------------------------------------
# Install Antidote (if missing)
# ---------------------------------------
if [[ ! -d "$ANTIDOTE_DIR" ]]; then
  echo "⚡ Installing antidote..."
  git clone --depth=1 https://github.com/mattmc3/antidote "$ANTIDOTE_DIR"
fi
source "$ANTIDOTE_DIR/antidote.zsh"

# ---------------------------------------
# Build plugin cache only when needed
# Edit ~/.zsh/plugins.txt to add/remove plugins — cache rebuilds automatically.
# ---------------------------------------
() {
  zmodload zsh/stat 2>/dev/null
  local _plugins_file="$ZSH_DIR/plugins.txt"
  local _pm_plugins=0 _pm_cache=0
  zstat -A _pm_plugins +mtime "$_plugins_file" 2>/dev/null
  zstat -A _pm_cache   +mtime "$CACHE_FILE"    2>/dev/null
  if (( _pm_plugins > _pm_cache )) || [[ ! -f "$CACHE_FILE" ]]; then
    echo "⚡ Rebuilding plugin cache..."
    antidote bundle <"$_plugins_file" >"$CACHE_FILE"
  fi
}

# ---------------------------------------
# Load plugins
# ---------------------------------------
source "$CACHE_FILE"

# use-omz (getantidote/use-omz) defers compinit to the first precmd via
# ensure-compinit-during-precmd, and even with ZSH_DISABLE_COMPFIX=true only
# runs `compinit -u` — which skips the interactive insecure-directory prompt
# but still pays for the full compaudit fpath scan every startup (~11ms
# measured) plus a `git rev-parse` dump-staleness check (~6ms measured).
# Preempt it here with a direct `-C` call (trust the existing dump
# unconditionally) and cancel use-omz's own deferred call so it doesn't also
# run. Reaches into use-omz's internal function names, not a public API: if a
# future antidote update renames them, this guard just no-ops and falls back
# to use-omz's own (slower) default — see `compreload` alias for a manual
# dump rebuild after adding completions for a new tool.
if (( ${+functions[compinit_deferred]} )); then
  autoload -Uz compinit
  compinit -C
  unfunction compinit_deferred 2>/dev/null
  add-zsh-hook -d precmd ensure-compinit-during-precmd 2>/dev/null
fi

# Applies EZA_COLORS/LS_COLORS/LESS_TERMCAP/FZF/ZSH_HIGHLIGHT/BAT_THEME/prompt
# colors for the cached theme, then re-detects in the background (see top of file).
_term_theme_init

# ---------------------------------------
# carapace: universal completion for 1000+ CLIs not covered by zsh-completions.
# Bridges fall back to native zsh/bash/fish completers (no regressions).
# Init output is static per carapace version -> cache it (mirrors plugin cache).
# Must run AFTER compinit (now run directly above, see the -C block).
# ---------------------------------------
if command -v carapace >/dev/null 2>&1; then
  export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
  () {
    local _cc_cache="${XDG_CACHE_HOME:-$HOME/.cache}/carapace-init.zsh"
    local _cc_bin; _cc_bin="$(command -v carapace)"
    local _m_bin=0 _m_cache=0
    zstat -A _m_bin   +mtime "$_cc_bin"    2>/dev/null
    zstat -A _m_cache +mtime "$_cc_cache"  2>/dev/null
    if (( _m_bin > _m_cache )) || [[ ! -s "$_cc_cache" ]]; then
      carapace _carapace zsh >| "$_cc_cache" 2>/dev/null
    fi
    source "$_cc_cache"
  }
fi

