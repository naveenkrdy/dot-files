}

TRAPUSR1() {
  local new_theme
  [[ -f "$_TERM_THEME_FILE" ]] && new_theme=$(<"$_TERM_THEME_FILE")
  if [[ -n "$new_theme" && "$new_theme" != "$_TERM_THEME" ]]; then
    _term_theme_apply "$new_theme"
    zle && zle reset-prompt
  fi
}

theme-refresh() {
  local detected
  detected=$(_term_theme_detect)
  print -r -- "$detected" >| "$_TERM_THEME_FILE"
  _term_theme_apply "$detected"
  zle && zle reset-prompt
}

_term_theme_init() {
  local cached="dark"
  [[ -f "$_TERM_THEME_FILE" ]] && cached=$(<"$_TERM_THEME_FILE")
  [[ -z "$cached" ]] && cached="dark"
  _term_theme_apply "$cached"

  if [[ -o interactive ]] && [[ "$TERM_PROGRAM" == "Apple_Terminal" ]]; then
    (
      local detected
      detected=$(_term_theme_detect)
      print -r -- "$detected" >| "$_TERM_THEME_FILE"
      kill -s USR1 $$ 2>/dev/null
    ) &!
  fi
}

