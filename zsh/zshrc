ccshell() {
  case "$1" in
    off|disable)
      ZSH_CLAUDE_SHELL_DISABLED=1
      echo "zsh-claude-code-shell: disabled"
      ;;
    on|enable)
      ZSH_CLAUDE_SHELL_DISABLED=0
      echo "zsh-claude-code-shell: enabled"
      ;;
    model)
      if [[ -z "$2" ]]; then
        echo "model: ${ZSH_CLAUDE_SHELL_MODEL:-default}"
      else
        ZSH_CLAUDE_SHELL_MODEL="$2"
        echo "zsh-claude-code-shell: model → $2"
      fi
      ;;
    context)
      if [[ -z "$2" ]]; then
        echo "context: $([[ ${ZSH_CLAUDE_SHELL_CONTEXT:-1} == 1 ]] && echo on || echo off)"
      elif [[ "$2" == "on" || "$2" == "1" ]]; then
        ZSH_CLAUDE_SHELL_CONTEXT=1
        echo "zsh-claude-code-shell: context injection on"
      else
        ZSH_CLAUDE_SHELL_CONTEXT=0
        echo "zsh-claude-code-shell: context injection off"
      fi
      ;;
    history)
      if (( ${#_ZSH_CLAUDE_SESSION[@]} == 0 )); then
        echo "(no history in this session)"
        return
      fi
      local i=1
      for entry in "${_ZSH_CLAUDE_SESSION[@]}"; do
        local q="${entry%%$'\x01'*}"
        local c="${entry#*$'\x01'}"
        echo "$i. # $q"
        echo "   → $c"
        (( i++ ))
      done
      ;;
    status|"")
      local st
      st="$([[ ${ZSH_CLAUDE_SHELL_DISABLED:-0} == 1 ]] && echo disabled || echo enabled)"
      echo "status:  $st"
      echo "model:   ${ZSH_CLAUDE_SHELL_MODEL:-default}"
      echo "context: $([[ ${ZSH_CLAUDE_SHELL_CONTEXT:-1} == 1 ]] && echo on || echo off)"
      echo "session: ${#_ZSH_CLAUDE_SESSION[@]} entries"
      ;;
    help)
      echo "Usage: ccshell <subcommand>"
      echo ""
      echo "Subcommands:"
      echo "  status              Show full state (enabled, model, context, session depth)"
      echo "  on | enable         Enable the '# <query>' → command widget"
      echo "  off | disable       Disable the widget (Enter works normally)"
      echo "  model               Show the current model"
      echo "  model <id>          Set the model for command generation"
      echo "  context             Show context injection state"
      echo "  context on|off      Toggle cwd/git/prev-cmd context injection"
      echo "  history             List generated commands from this shell session"
      echo "  help                Show this help"
      echo ""
      echo "Available models:"
      echo "  claude-haiku-4-5-20251001   Fastest, lowest cost"
      echo "  claude-sonnet-4-6           Balanced (default)"
      echo "  claude-opus-4-8             Most capable"
      echo "  claude-fable-5              Fable 5"
      echo ""
      echo "Context injection (on by default):"
      echo "  Prepends [cwd:X, git:Y, prev:\"Z\"] to each query so Claude has"
      echo "  directory, branch, and last-generated-command context."
      echo "  Enables follow-ups like '# do it recursively' to work correctly."
      echo ""
      echo "Examples:"
      echo "  ccshell model claude-haiku-4-5-20251001"
      echo "  ccshell off"
      echo "  ccshell context off"
      echo "  ccshell history"
      ;;
    *)
      echo "Unknown subcommand: $1"
      echo "Run 'ccshell help' for usage."
      ;;
  esac
}

_zsh_claude_context_wrap() {
  local orig_buf="$BUFFER"
  local is_query=0
  [[ "$orig_buf" =~ ^'# ' ]] && is_query=1

  if (( is_query )) && [[ "${ZSH_CLAUDE_SHELL_CONTEXT:-1}" == "1" ]] && [[ "${ZSH_CLAUDE_SHELL_DISABLED:-0}" != "1" ]]; then
    local query="${orig_buf:2}"
    local ctx_parts=("cwd:${PWD:t}")
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) && ctx_parts+=("git:$branch")
    if (( ${#_ZSH_CLAUDE_SESSION[@]} > 0 )); then
      local prev_cmd="${_ZSH_CLAUDE_SESSION[-1]#*$'\x01'}"
      ctx_parts+=("prev:\"$prev_cmd\"")
    fi
    BUFFER="# [${(j:, :)ctx_parts}] $query"
  fi

  _zsh_claude_accept_line

  if (( is_query )) && [[ "${ZSH_CLAUDE_SHELL_DISABLED:-0}" != "1" ]] && [[ -n "$BUFFER" ]] && [[ ! "$BUFFER" =~ ^'# ' ]]; then
    _ZSH_CLAUDE_SESSION+=("${orig_buf:2}"$'\x01'"$BUFFER")
    (( ${#_ZSH_CLAUDE_SESSION[@]} > 5 )) && _ZSH_CLAUDE_SESSION=("${_ZSH_CLAUDE_SESSION[@]: -5}")
  fi
}
