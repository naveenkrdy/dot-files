# `ls` renders a Nushell-style bordered table (falls back to eza/gls if nu is unavailable).
# `unalias` clears oh-my-zsh's lib/directories.zsh defaults / any earlier alias so the
# function definition doesn't collide with an existing alias of the same name.
unalias ls 2>/dev/null
if command -v nu >/dev/null 2>&1; then
  function ls {
    # oh-my-zsh's default `l='ls -lah'` forwards flags like -lah here; ignore flag-style
    # args (nu's `ls` doesn't take them) but still honor a trailing path argument.
    local target="."
    (( $# > 0 )) && [[ "${@[-1]}" != -* ]] && target="${@[-1]}"
    nu -c "cd '$target'; ls | table"
  }
elif command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first --icons=auto'
elif command -v gls >/dev/null 2>&1; then
  alias ls='gls --color=auto --group-directories-first'
fi

