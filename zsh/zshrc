# ── Helpers ──────────────────────────────────────────────────────────────

_prompt_battery() {
  command -v pmset &>/dev/null || return
  if (( EPOCHREALTIME - _pbc_ts > 60 )); then
    local out=$(pmset -g batt 2>/dev/null)
    _pbc_ts=$EPOCHREALTIME
    _pbc_val=""
    if [[ "$out" == *"discharging"* ]]; then
      local pct=${${out#*$'\t'}%%%*}; pct=${pct##* }
      [[ "$pct" =~ ^[0-9]+$ ]] && (( pct < 20 )) && _pbc_val="$pct"
    fi
  fi
  [[ -n "$_pbc_val" ]] && print -n "$_pbc_val"
}

_prompt_sudo_active() {
  if (( EPOCHREALTIME - _psc_ts > 30 )); then
    sudo -n true 2>/dev/null; _psc_val=$?; _psc_ts=$EPOCHREALTIME
  fi
  return $_psc_val
}

# ── RPROMPT: language pills + elapsed ────────────────────────────────────

_prompt_build_rprompt() {
  local r=""
  local IC_PY=$'\ue606'
  local IC_NODE=$'\ued0d'
  local IC_RUBY=$'\ue791'

  # Reset shared state
  _prompt_ahead=0
  _prompt_behind=0
  _prompt_stash=0
  _prompt_branch=""
  _prompt_branch_color=""
  _prompt_unstaged=0
  _prompt_staged=0
  _prompt_untracked=0

  # Python pill — cached by env key
  if [[ -f requirements.txt || -f pyproject.toml || -f setup.py || -f Pipfile || -n "$VIRTUAL_ENV" ]] && command -v python3 &>/dev/null; then
    local py_key="${CONDA_DEFAULT_ENV:-}:${VIRTUAL_ENV:-}:${PYENV_VERSION:-}:${PATH%%:*}"
    [[ "$py_key" != "$_pvc_py_key" ]] && { _pvc_py=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null); _pvc_py_key="$py_key" }
    local pv="$_pvc_py"
    if [[ -n "$pv" ]]; then
      r+="%{"$'\e[48;2;42;58;42m\e[38;2;152;200;127m'"%} ${IC_PY} ${pv} %{"$'\e[49m\e[0m'"%}"
    fi
  fi

  # Node pill — cached by env key
  if [[ -f package.json || -f .nvmrc || -f .node-version ]] && command -v node &>/dev/null; then
    local node_key="${NVM_BIN:-}:${NODENV_ROOT:-}:${PATH%%:*}"
    [[ "$node_key" != "$_pvc_node_key" ]] && { _pvc_node=$(node -v 2>/dev/null); _pvc_node_key="$node_key" }
    local nv="$_pvc_node"
    if [[ -n "$nv" ]]; then
      r+="%{"$'\e[48;2;42;52;69m\e[38;2;154;184;212m'"%} ${IC_NODE} ${nv#v} %{"$'\e[49m\e[0m'"%}"
    fi
  fi

  # Ruby pill — cached by env key
  if [[ -f Gemfile || -f .ruby-version ]] && command -v ruby &>/dev/null; then
    local ruby_key="${RBENV_VERSION:-}:${GEM_HOME:-}:${PATH%%:*}"
    [[ "$ruby_key" != "$_pvc_ruby_key" ]] && { _pvc_ruby=$(ruby -e 'print RUBY_VERSION' 2>/dev/null); _pvc_ruby_key="$ruby_key" }
    local rv="$_pvc_ruby"
    if [[ -n "$rv" ]]; then
      r+="%{"$'\e[48;2;58;38;40m\e[38;2;236;128;137m'"%} ${IC_RUBY} ${rv} %{"$'\e[49m\e[0m'"%}"
    fi
  fi

  # Battery
  local batt=$(_prompt_battery)
  if [[ -n "$batt" ]]; then
    r+="%{"$'\e[48;2;58;38;40m\e[38;2;236;128;137m'"%} ⚡${batt}%% %{"$'\e[49m\e[0m'"%}"
  fi

  # Elapsed time pill
  if [[ -n "$_prompt_elapsed" ]]; then
    r+="%{"$'\e[48;2;42;42;42m\e[38;2;180;178;169m'"%} ~${_prompt_elapsed}s %{"$'\e[49m\e[0m'"%}"
  fi

  # ── Populate globals for PROMPT left side — single git call + pure zsh ──
  local git_out
  git_out=$(git status --porcelain=v2 --branch 2>/dev/null) || git_out=""
  if [[ -n "$git_out" ]]; then
    local git_lines=("${(f)git_out}")

    local branch="${${git_lines[(r)# branch.head *]}#'# branch.head '}"
    [[ "$branch" == "(detached)" ]] && branch="HEAD"

    local ab_line="${git_lines[(r)# branch.ab *]}"
    if [[ -n "$ab_line" ]]; then
      _prompt_ahead="${${ab_line#*+}%% *}"
      _prompt_behind="${ab_line##*-}"
    fi

    local staged="" unstaged="" untracked=""
    local _sa=("${(M)git_lines[@]:#1 [!.]*}")
    local _ua=("${(M)git_lines[@]:#1 ?[!.]*}")
    local _ta=("${(M)git_lines[@]:#\? *}")
    (( ${#_sa} )) && { staged=1;   _prompt_staged=1 }
    (( ${#_ua} )) && { unstaged=1; _prompt_unstaged=1 }
    (( ${#_ta} )) && { untracked=1; _prompt_untracked=1 }

    if [[ -n "$branch" ]]; then
      # Pure zsh .git walk — no fork
      local git_dir="" _d="$PWD"
      while [[ "$_d" != "/" ]]; do
        if [[ -f "$_d/.git" ]]; then
          local _gc=$(<"$_d/.git")
          git_dir="${${_gc##gitdir: }%%$'\n'*}"
          [[ "${git_dir:0:1}" != "/" ]] && git_dir="$_d/$git_dir"
          break
        elif [[ -d "$_d/.git" ]]; then
          git_dir="$_d/.git"; break
        fi
        _d="${_d:h}"
      done

      local action=""
      if [[ -n "$git_dir" ]]; then
        if   [[ -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" ]]; then action="rebase"
        elif [[ -f "$git_dir/MERGE_HEAD" ]];       then action="merge"
        elif [[ -f "$git_dir/CHERRY_PICK_HEAD" ]]; then action="cherry-pick"
        fi
        [[ -f "$git_dir/refs/stash" ]] && _prompt_stash=$(git stash list 2>/dev/null | wc -l)
        _prompt_stash="${_prompt_stash// /}"
      fi

      if [[ -n "$action" ]]; then
        _prompt_branch="${branch} (${action})"
        _prompt_branch_color="${_PC_GIT_ACTION}"
      else
        _prompt_branch="$branch"
        if   [[ -n "$unstaged" && -n "$staged" ]]; then _prompt_branch_color="${_PC_GIT_BRANCH_MIXED}"
        elif [[ -n "$unstaged" ]]; then _prompt_branch_color="${_PC_GIT_DIRTY}"
        elif [[ -n "$staged"   ]]; then _prompt_branch_color="${_PC_GIT_STAGED}"
        elif [[ -n "$untracked" ]]; then _prompt_branch_color="${_PC_GIT_BRANCH_UNTRACK}"
        else _prompt_branch_color="${_PC_GIT_CLEAN}"
        fi
      fi
    fi
  fi

  RPROMPT="$r"
}

# ── PROMPT: folder · branch · ↑↓ · stash · sudo · ❯ ─────────────────────

_prompt_build_prompt() {
  local exit_code=$1
  local job_count=${#jobstates}
  local p=""

  # Folder name
  local folder="${PWD:t}"
  [[ "$PWD" == "$HOME" ]] && folder="~"
  [[ "$PWD" == "/" ]] && folder="/"
  p+="%{${_PC_FOLDER}%}${folder}%{${_PC_RST}%} "

  # SSH context
  if [[ -n "$SSH_CLIENT$SSH_TTY" ]]; then
    local ssh_port="${SSH_CLIENT##* }"
    p+="%{${_PC_SSH_USER}%}${USER}%{${_PC_SSH}%}@${HOST%%.*}:${ssh_port}%{${_PC_RST}%} "
  fi

  # Branch
  if [[ -n "$_prompt_branch" ]]; then
    p+="%{${_PC_DIM}%}on%{${_PC_RST}%} "
    p+="%{${_prompt_branch_color}%}${_prompt_branch}%{${_PC_RST}%} "
  fi

  # Ahead/behind
  if (( _prompt_ahead > 0 )); then
    p+="%{${_PC_GIT_AHEAD}%}↑%{${_PC_RST}%}"
  fi
  if (( _prompt_behind > 0 )); then
    p+="%{${_PC_GIT_BEHIND}%}↓%{${_PC_RST}%}"
  fi
  if (( _prompt_ahead > 0 || _prompt_behind > 0 )); then
    p+=" "
  fi

  # Stash count
  if (( _prompt_stash > 0 )); then
    p+="%{${_PC_GIT_STASH}%}${_prompt_stash}%{${_PC_RST}%} "
  fi

  # Exit code
  if (( exit_code != 0 )); then
    p+="%{${_PC_EXIT}%}${exit_code}%{${_PC_RST}%} "
  fi

  # Jobs
  if (( job_count > 0 )); then
    p+="%{${_PC_BUSY}%}${job_count}&%{${_PC_RST}%} "
  fi

  # Sudo — # before arrow
  if _prompt_sudo_active; then
    p+="%{${_PC_SUDO}%}#%{${_PC_RST}%}"
  fi

  # Arrow
  if (( exit_code != 0 )); then
    p+="%{${_PC_ERR}%}${_PG_ARROW}%{${_PC_RST}%} "
  elif (( job_count > 0 )); then
    p+="%{${_PC_BUSY}%}${_PG_ARROW}%{${_PC_RST}%} "
  else
    p+="%{${_PC_OK}%}${_PG_ARROW}%{${_PC_RST}%} "
  fi

  PROMPT="$p"
}

