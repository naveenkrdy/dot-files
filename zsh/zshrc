# ---------------------------------------
# Terminal.app theme detection (light/dark)
# Terminal.app has no built-in auto light/dark switching, so this
# luminance-buckets the active window's actual background color via
# AppleScript (~60-80ms) and switches EZA_COLORS/LS_COLORS/LESS_TERMCAP/
# FZF/ZSH_HIGHLIGHT/prompt colors to match. Detection is done async so
# shell startup stays fast: init applies the last cached theme instantly,
# then re-detects in the background and snaps colors via TRAPUSR1 if it
# changed. Not to be confused with $_PROMPT_THEME (compact/full layout).
# ---------------------------------------
typeset -g _TERM_THEME="dark"
typeset -g _TERM_THEME_FILE="$CACHE_DIR/.term_theme"

_term_theme_query() {
  local rgb r g b
  rgb=$(osascript -e 'tell application "Terminal" to background color of front window' 2>/dev/null)
  [[ -z "$rgb" ]] && return 1
  IFS=', ' read -r r g b <<< "$rgb"
  [[ -z "$r" || -z "$g" || -z "$b" ]] && return 1
  if (( (r + g + b) / 3 < 32768 )); then
    print -r -- dark
  else
    print -r -- light
  fi
}

_term_theme_detect() {
  local result
  result=$(_term_theme_query)
  if [[ -z "$result" ]]; then
    if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == "Dark" ]]; then
      result="dark"
    else
      result="light"
    fi
  fi
  print -r -- "$result"
}

