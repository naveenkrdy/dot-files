zstyle ':completion:*:options' description yes
zstyle ':completion:*:descriptions' format $'\n\e[1;37m%d\e[0m'
zstyle ':completion:*:messages' format $'%{\e[38;05;239m%} Message : %d%{\e[m%}'
zstyle ':completion:*:warnings' format $'%{\e[38;05;238m%} No matches in %d%{\e[m%}'
zstyle ':completion:*' select-prompt $'%{\e[38;05;249m%}%SSelection at %p%s%{\e[m%}'
zstyle ':completion:*' completer _complete _ignored _approximate
zstyle ':completion:*' list-packed true
zstyle ':completion:*' list-dirs-first true
zstyle ':completion:*' list-separator ''
zstyle ':completion:*' group-order options arguments values directories files
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':bracketed-paste-magic' active-widgets '.self-*'

# ---------------------------------------
# fzf-tab settings
# ---------------------------------------
zstyle ':fzf-tab:*' show-group none
zstyle ':fzf-tab:*' prefix ''
zstyle ':fzf-tab:*' switch-group ',' '.'
zstyle ':fzf-tab:*' fzf-command fzf
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' fzf-flags --height=75% --layout=reverse --border --inline-info --preview-window=right:40% --bind=alt-p:toggle-preview
zstyle ':fzf-tab:complete:(cd|ls|eza|gls):*' fzf-preview '
if [[ -d "$realpath" ]]; then
  command eza --group-directories-first --icons -a --color=always -- "$realpath" 2>/dev/null || command gls -a --color=always -- "$realpath"
elif [[ -f "$realpath" ]]; then
  size=$(stat -f%z "$realpath" 2>/dev/null)
  if [[ -n "$size" && "$size" -gt 512000 ]]; then
    printf "File too large to preview\n\n"
    printf "Name: %s\n" "$(basename -- "$realpath")"
    printf "Size: %s KB\n" "$(( size / 1024 ))"
    exit 0
  fi
  if command -v bat >/dev/null 2>&1; then
    bat --style=numbers --color=always --line-range :300 -- "$realpath"
  else
    sed -n "1,200p" -- "$realpath"
  fi
else
  command gls -a --color=always -- "$(dirname -- "$realpath")"
fi
'

